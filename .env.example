# DEVELOPMENT ONLY. These values are intentionally simple and are not safe for production.

# PoultryFlow PostgreSQL database
POSTGRES_DB=poultryflow
POSTGRES_USER=poultryflow_dev
POSTGRES_PASSWORD=dev-only-poultryflow-password
POSTGRES_PORT=5432

# Keycloak PostgreSQL database
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak_dev
KEYCLOAK_DB_PASSWORD=dev-only-keycloak-db-password

# Keycloak development server
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=admin
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=dev-only-keycloak-admin-password
KEYCLOAK_PORT=8081
KEYCLOAK_MANAGEMENT_PORT=9001
