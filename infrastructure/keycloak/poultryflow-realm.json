{
  "realm": "poultryflow",
  "enabled": true,
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "roles": {
    "client": {
      "poultryflow-api": [
        {
          "name": "OWNER",
          "description": "Highest coarse application role; farm access remains membership-constrained."
        },
        {
          "name": "MANAGER",
          "description": "Farm manager with operational management access."
        },
        {
          "name": "STAFF",
          "description": "Farm staff member with operational working access."
        },
        {
          "name": "ACCOUNTANT",
          "description": "Finance-focused application role for future financial policies."
        },
        {
          "name": "VIEWER",
          "description": "Read-only application access."
        }
      ]
    }
  },
  "clients": [
    {
      "clientId": "poultryflow-web",
      "name": "PoultryFlow Web",
      "description": "Public development client for the PoultryFlow React application.",
      "enabled": true,
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "rootUrl": "http://localhost:5173",
      "baseUrl": "http://localhost:5173/",
      "redirectUris": [
        "http://localhost:5173/",
        "http://localhost:5173/silent-check-sso.html"
      ],
      "webOrigins": [
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/"
      },
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "poultryflow-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "poultryflow-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "poultryflow-api",
      "name": "PoultryFlow API",
      "description": "Logical audience for the PoultryFlow OAuth2 Resource Server.",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect"
    }
  ]
}
